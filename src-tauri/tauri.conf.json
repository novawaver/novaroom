{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Novaroom",
  "version": "0.1.1",
  "identifier": "com.novawave.novaroom",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Novaroom",
        "decorations": false,
        "width": 1120,
        "height": 760,
        "minWidth": 880,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "Novawave",
    "copyright": "Copyright © 2026 Novawave",
    "category": "SocialNetworking",
    "shortDescription": "Chat for AI trainers",
    "longDescription": "Novaroom is a Windows chat app for annotators, raters, and prompt writers. Join a topic room, or start a direct chat or a small group.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDczQzFDQUE3QkJGOTVDMDAKUldRQVhQbTdwOHJCY3liamxWcU9qaTBzekxYV25kVjRQRXlQTDZhNURhVS9lMDhqV21kQ2FCMWYK",
      "endpoints": ["https://github.com/novawaver/novaroom/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
